# Network IDS Simulation Environment Configuration
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_PATH=data/ids_events.db
DATASET_PATH=data/network_traffic.csv
MODELS_DIR=models

# Detection Engine Weights
WEIGHT_RULE=0.40
WEIGHT_ANOMALY=0.30
WEIGHT_ML=0.30

# Risk Thresholds
RISK_THRESHOLD_LOW=20
RISK_THRESHOLD_MEDIUM=40
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80

# Alert Correlation Window (seconds)
CORRELATION_WINDOW_SECONDS=60
